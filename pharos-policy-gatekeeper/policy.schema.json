{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Acarumba/pharos-season-of-ai/policy.schema.json",
  "title": "Pharos Policy Gatekeeper Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["spend_limit", "allowlist", "time_window"],
  "properties": {
    "spend_limit": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "description": "Non-negative decimal amount. Decimal arithmetic is used at runtime."
    },
    "allowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addresses", "contracts"],
      "properties": {
        "addresses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evmAddress" }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evmAddress" }
        }
      }
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "start", "end"],
      "properties": {
        "timezone": {
          "type": "string",
          "description": "IANA timezone name, for example UTC or America/New_York."
        },
        "start": { "$ref": "#/$defs/clockTime" },
        "end": { "$ref": "#/$defs/clockTime" }
      }
    }
  },
  "$defs": {
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "clockTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}